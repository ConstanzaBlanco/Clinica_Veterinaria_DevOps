{
  "info": {
    "_postman_id": "878571f6-d981-42da-a47d-15f032302649",
    "name": "Pet-Core ANDIS",
    "description": "Peticiones para demostrar las tacticas de arquitectura de Pet-Core.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "Iniciar sesion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El inicio de sesion fue correcto\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const respuesta = pm.response.json();",
                  "    pm.collectionVariables.set(\"access_token\", respuesta.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo_prueba}}\",\n  \"contrasena\": \"{{contrasena_prueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Inicia sesion y guarda el JWT en la variable access_token de la coleccion."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Disponibilidad",
      "item": [
        {
          "name": "Identificar instancia",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La API responde correctamente\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"La respuesta identifica la instancia\", function () {",
                  "    const respuesta = pm.response.json();",
                  "    pm.expect(respuesta).to.have.property(\"instancia\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/demo/instancia",
              "host": ["{{base_url}}"],
              "path": ["demo", "instancia"]
            },
            "description": "Identifica el contenedor de FastAPI que atendio la solicitud. Requiere autenticacion."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "correo_prueba",
      "value": "ana.cliente@petcore.com",
      "type": "string"
    },
    {
      "key": "contrasena_prueba",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ]
}
