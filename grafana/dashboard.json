      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Turnos: p95 de consulta PostgreSQL vs endpoint",
          "description": "Comparación temporal en ventanas de 5 minutos. Query incluye ejecución y lectura desde SQLAlchemy, también fallos. HTTP mide todos los GET /turnos e incluye autenticación y serialización. Son percentiles de poblaciones distintas: no deben restarse ni prueban causalidad. Sin solicitudes no hay percentil.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.95, sum by (le) (rate(pg_query_duration_seconds_bucket{job=\"pet-core-api\",query=\"listar_turnos_cliente\"}[5m])))",
                        "legendFormat": "PostgreSQL: listar turnos (p95)"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"pet-core-api\",handler=\"/turnos\",method=\"GET\"}[5m])))",
                        "legendFormat": "HTTP: GET /turnos (p95)"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
